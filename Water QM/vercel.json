{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/reports_files/(.*)", "destination": "/api/index.js" },
    { "source": "/dataset-checker", "destination": "/index.html" },
    { "source": "/safety-checker", "destination": "/index.html" },
    { "source": "/hardware-lab", "destination": "/index.html" },
    { "source": "/community-issues", "destination": "/index.html" },
    { "source": "/complaints", "destination": "/index.html" },
    { "source": "/((?!api|css|js|assets|reference_screenshots|reports_files).*)", "destination": "/index.html" }
  ]
}
