# AquaMonitor Pro Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local MongoDB)
# If omitted or unavailable, AquaMonitor Pro automatically uses persistent local storage with full integrity
MONGODB_URI=mongodb://localhost:27017/aquamonitor

# JWT Secret
JWT_SECRET=aquamonitor_super_secret_jwt_key_2026

# Admin Configuration
ADMIN_NOTIFICATION_EMAIL=admin@aquamonitor.in

# Razorpay Configuration (Sandbox / Production)
RAZORPAY_KEY_ID=rzp_test_aquamonitor2026
RAZORPAY_KEY_SECRET=aquamonitor_secret_test_key

# Nodemailer / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AquaMonitor Alerts <alerts@aquamonitor.in>
